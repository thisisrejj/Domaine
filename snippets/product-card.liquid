<div class="relative w-full bg-white rounded-2xl overflow-hidden shadow-sm">

  <div class="image-wrapper border border-gray-200 rounded-[10px]">
  <!-- SALE BADGE -->
  {% if product.compare_at_price_max > product.price %}
    <div class="absolute top-3 left-3 z-10">
      <span class="border rounded-[25.61px] text-[#FF0000] font-[Franklin-Gothic-ATF] font-medium text-[15.37px] leading-[17.93px] tracking-[0%] text-center" style="border-color: #FF0000;">
        On Sale!
      </span>
    </div>
  {% endif %}

  <!-- IMAGE WRAPPER: hover applies only here -->
  <div class="relative w-full aspect-[4/5] overflow-hidden group">

    <!-- PRIMARY IMAGE -->
    <img 
      src="{{ product.featured_image | image_url: width: 800 }}"
      alt="{{ product.title }}"
      loading="lazy"
      class="primary-image w-full h-full object-cover transition-all duration-500 ease-in-out group-hover:opacity-0"
    />

    <!-- SECONDARY IMAGE -->
    {% if product.images.size > 1 %}
      <img 
        src="{{ product.images[1] | image_url: width: 800 }}"
        alt="{{ product.title }}"
        loading="lazy"
        class="secondary-image absolute inset-0 w-full h-full object-cover opacity-0 transition-all duration-500 ease-in-out group-hover:opacity-100"
      />
    {% endif %}

  </div>
  </div>
  <!-- CONTENT -->
  <div class="p-3">

    <!-- COLOR SWATCHES -->
    {% for option in product.options_with_values %}
      {% if option.name == 'Color' %}
        <div class="flex gap-2 mt-3">
          {% for variant in product.variants %}
            {% if variant.option1 %}
              
              {% comment %}
                Secondary image: next image in product.images based on variant order
              {% endcomment %}
              {% assign primary_image = variant.featured_image | image_url: width: 800 %}

              {% assign featured_index = 0 %}
              {% for img in product.images %}
                {% if img == variant.featured_image %}
                  {% assign featured_index = forloop.index0 %}
                {% endif %}
              {% endfor %}

              {% assign next_index = featured_index | plus: 1 %}

              {% if product.images[next_index] %}
                {% assign secondary_image = product.images[next_index] | image_url: width: 800 %}
              {% else %}
                {% assign secondary_image = primary_image %}
              {% endif %}

              <button
                class="swatch w-5 h-5 rounded-full border transition-all duration-200 hover:scale-110 focus:outline-none border border-[length:1px] rounded-full" style="border-color: #0A4874; background-color: {{ variant.option1 | downcase }}"
                data-image="{{ primary_image }}"
                data-secondary="{{ secondary_image }}"
                data-price="{{ variant.price | money }}"
                aria-label="{{ variant.option1 }}"
              ></button>

            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    {% endfor %}

        <!-- BRAND -->
    <p class="text-[#111111] uppercase font-[Roboto] font-normal text-[14px] leading-[16px] tracking-[0%] text-center">{{ product.vendor }}</p>

    <!-- TITLE -->
    <h3 class="font-[Roboto] font-medium text-[16px] leading-[18px] tracking-[0%] text-[#0A4874]">{{ product.title }}</h3>

    <!-- PRICE -->
    <div class="mt-1 flex gap-2 items-center">
      <span class="product-price font-semibold">{{ product.price | money }}</span>
      {% if product.compare_at_price_max > product.price %}
        <span class="line-through text-gray-400 text-sm">{{ product.compare_at_price_max | money }}</span>
      {% endif %}
    </div>

  </div>

</div>