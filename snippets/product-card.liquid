<div class="group relative w-full">

  <div class="relative bg-white rounded-2xl overflow-hidden">

    <!-- SALE BADGE -->
    {% if product.compare_at_price_max > product.price %}
      <div class="absolute top-3 left-3 z-10">
        <span class="bg-black text-white text-[11px] px-2 py-1 rounded-full">
          SALE
        </span>
      </div>
    {% endif %}

    <!-- IMAGE WRAPPER -->
    <div class="relative w-full aspect-[4/5] overflow-hidden bg-gray-100">

      <!-- PRIMARY -->
      <img 
        src="{{ product.featured_image | image_url: width: 800 }}"
        class="primary-image w-full h-full object-cover transition duration-500 ease-in-out group-hover:opacity-0"
      />

      <!-- SECONDARY -->
      {% if product.images.size > 1 %}
        <img 
          src="{{ product.images[1] | image_url: width: 800 }}"
          class="secondary-image absolute inset-0 w-full h-full object-cover opacity-0 transition duration-500 ease-in-out group-hover:opacity-100"
        />
      {% endif %}

    </div>

    <!-- CONTENT -->
    <div class="p-3">

      <p class="text-xs text-gray-500 uppercase">
        {{ product.vendor }}
      </p>

      <h3 class="text-sm font-medium mt-1">
        {{ product.title }}
      </h3>

      <div class="mt-1 flex gap-2 items-center">
        <span class="product-price font-semibold">
          {{ product.price | money }}
        </span>

        {% if product.compare_at_price_max > product.price %}
          <span class="line-through text-gray-400 text-sm">
            {{ product.compare_at_price_max | money }}
          </span>
        {% endif %}
      </div>

      <!-- SWATCHES -->
      {% for option in product.options_with_values %}
        {% if option.name == 'Color' %}
          <div class="flex gap-2 mt-3">

            {% for variant in product.variants %}
              {% if variant.option1 %}
                <button
                  class="swatch w-5 h-5 rounded-full border"
                  style="background-color: {{ variant.option1 | downcase }}"
                  data-image="{{ variant.featured_image | image_url: width: 800 }}"
                  data-secondary="{% if product.images.size > 1 %}{{ product.images[1] | image_url: width: 800 }}{% endif %}"
                  data-price="{{ variant.price | money }}"
                ></button>
              {% endif %}
            {% endfor %}

          </div>
        {% endif %}
      {% endfor %}

    </div>

  </div>

</div>

<div class="bg-red-500 text-white p-4">
  Tailwind is working
</div>