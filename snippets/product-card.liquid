<div class="group relative border rounded-lg p-4">

  <!-- SALE BADGE -->
  {% if product.compare_at_price_max > product.price %}
    <span class="absolute top-2 left-2 bg-red-500 text-white text-xs px-2 py-1">
      Sale
    </span>
  {% endif %}

  <!-- PRODUCT IMAGE -->
  <div class="relative overflow-hidden">
    <img 
      src="{{ product.featured_image | image_url: width: 500 }}" 
      alt="{{ product.title }}"
      class="w-full transition-opacity duration-300 group-hover:opacity-0 primary-image"
    />

    {% if product.images.size > 1 %}
      <img 
        src="{{ product.images[1] | image_url: width: 500 }}"
        class="w-full absolute top-0 left-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 secondary-image"
      />
    {% endif %}
  </div>

  <!-- PRODUCT INFO -->
  <div class="mt-4">
    <p class="text-sm text-gray-500">{{ product.vendor }}</p>
    <h3 class="text-lg font-semibold">{{ product.title }}</h3>

    <div class="flex items-center gap-2 mt-1">
      <span class="text-black font-bold product-price">
        {{ product.price | money }}
      </span>

      {% if product.compare_at_price_max > product.price %}
        <span class="text-gray-400 line-through">
          {{ product.compare_at_price_max | money }}
        </span>
      {% endif %}
    </div>
  </div>

  <!-- VARIANT SWATCHES -->
  <div class="flex gap-2 mt-3">
    {% for option in product.options_with_values %}
      {% if option.name == 'Color' %}
        {% for value in option.values %}
          {% assign variant = product.variants | where: "option1", value | first %}

          <button 
            class="w-6 h-6 rounded-full border swatch"
            style="background-color: {{ value | downcase }}"
            data-image="{{ variant.featured_image | image_url: width: 500 }}"
            data-price="{{ variant.price | money }}"
          ></button>
        {% endfor %}
      {% endif %}
    {% endfor %}
  </div>

</div>